# Shared by the Express server. Never commit your real .env.
NODE_ENV=development
# Use review only for an explicitly public, no-charge portfolio/mentor deployment.
DEPLOYMENT_MODE=standard
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/imovies?replicaSet=rs0
# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
COOKIE_SECURE=false
ALLOW_PREVIEW=false
TRUST_PROXY=0
PAYMENT_PROVIDER=demo
# Demo payments are always disabled in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only used by the explicitly run seed/admin scripts, never on server startup.
SEED_ADMIN_EMAIL=admin@imovies.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=alex@imovies.local
SEED_USER_PASSWORD=Movie@12345
