# LOCAL ONLY: used by npm run seed:review. Never commit the filled .env.hosted file.
# This is a separate, disposable review database, not a real customer database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/imovies_review?retryWrites=true&w=majority
REVIEW_DATABASE_CONFIRM=YES
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SEED_ADMIN_EMAIL=review-admin@imovies.example
SEED_ADMIN_PASSWORD=replace-with-a-strong-review-admin-password
SEED_USER_EMAIL=reviewer@imovies.example
SEED_USER_PASSWORD=replace-with-a-strong-review-user-password
